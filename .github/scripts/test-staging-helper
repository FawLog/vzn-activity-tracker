#!/bin/bash
set -Eeuo pipefail

readonly STAGING_ROOT="/var/lib/vzn-deploy-staging"
readonly INSTALLED_STAGER="/usr/local/sbin/vzn-stage-vzn-artifacts"
readonly INSTALLED_DEPLOYER="/usr/local/sbin/vzn-deploy"
readonly INSTALLED_UPDATER="/usr/local/sbin/vzn-update"
readonly INSTALLED_SUDOERS_HELPER="/usr/local/sbin/vzn-manage-sudoers"
readonly INSTALLED_HEALTHCHECK_HELPER="/usr/local/lib/vzn-activity-tracker/healthcheck.sh"

fixture_root="$(mktemp -d)"
cleanup() {
  sudo rm -rf -- "${STAGING_ROOT}"
  sudo rm -rf -- /var/lib/vzn-update-staging
  sudo rm -f -- "${INSTALLED_STAGER}" "${INSTALLED_DEPLOYER}" "${INSTALLED_UPDATER}" "${INSTALLED_SUDOERS_HELPER}"
  sudo rm -rf -- /usr/local/lib/vzn-activity-tracker
  rm -rf -- "${fixture_root}"
}
trap cleanup EXIT

commit="$(printf 'a%.0s' {1..40})"
artifact_root="${fixture_root}/artifacts"
install -d "${artifact_root}/frontend" "${artifact_root}/backend" "${artifact_root}/deployment"

install -d "${fixture_root}/frontend-payload"
printf '<!doctype html>\n' > "${fixture_root}/frontend-payload/index.html"
frontend_archive="${artifact_root}/frontend/vzn-frontend-${commit}.tar.gz"
tar --create --gzip --file "${frontend_archive}" --directory "${fixture_root}/frontend-payload" .
(cd "$(dirname "${frontend_archive}")" && sha256sum "$(basename "${frontend_archive}")" > \
  "$(basename "${frontend_archive}.sha256")")

install -d "${fixture_root}/backend-payload"
printf 'image fixture\n' > "${fixture_root}/backend-payload/image.txt"
backend_archive="${artifact_root}/backend/vzn-backend-${commit}.tar.gz"
tar --create --gzip --file "${backend_archive}" --directory "${fixture_root}/backend-payload" .
(cd "$(dirname "${backend_archive}")" && sha256sum "$(basename "${backend_archive}")" > \
  "$(basename "${backend_archive}.sha256")")
printf 'VZN_IMAGE_TAG=ci-%s\nGIT_COMMIT=%s\n' "${commit}" "${commit}" > \
  "${artifact_root}/backend/vzn-backend-${commit}.manifest"

deployment_payload="${fixture_root}/deployment-payload"
install -d "${deployment_payload}/deploy/root"
printf '%s\n' "${commit}" > "${deployment_payload}/REVISION"
install -m 0755 deploy/root/install-vzn-activity-tracker \
  "${deployment_payload}/deploy/root/install-vzn-activity-tracker"
install -m 0755 deploy/root/manage-vzn-sudoers \
  "${deployment_payload}/deploy/root/manage-vzn-sudoers"
install -m 0755 deploy/root/healthcheck.sh \
  "${deployment_payload}/deploy/root/healthcheck.sh"
install -m 0755 deploy/root/update-vzn-activity-tracker \
  "${deployment_payload}/deploy/root/update-vzn-activity-tracker"
deployment_archive="${artifact_root}/deployment/vzn-deployment-${commit}.tar.gz"
tar --create --gzip --file "${deployment_archive}" --directory "${deployment_payload}" .
(cd "$(dirname "${deployment_archive}")" && sha256sum "$(basename "${deployment_archive}")" > \
  "$(basename "${deployment_archive}.sha256")")

sudo install -o root -g root -m 0755 deploy/root/stage-vzn-artifacts "${INSTALLED_STAGER}"
sudo "${INSTALLED_STAGER}" "${artifact_root}"

[[ "$(stat --format='%U:%G:%a' "${STAGING_ROOT}")" == "root:root:750" ]]
[[ "$(sudo sed -n '1p' "${STAGING_ROOT}/source/REVISION" | tr -d '\r\n')" == "${commit}" ]]
[[ "$(stat --format='%U:%G:%a' "${INSTALLED_DEPLOYER}")" == "root:root:755" ]]
[[ "$(stat --format='%U:%G:%a' "${INSTALLED_HEALTHCHECK_HELPER}")" == "root:root:755" ]]
cmp deploy/root/install-vzn-activity-tracker "${INSTALLED_DEPLOYER}"

sudo "${INSTALLED_STAGER}" --update "${artifact_root}"
[[ "$(stat --format='%U:%G:%a' /var/lib/vzn-update-staging)" == "root:root:750" ]]
[[ "$(stat --format='%U:%G:%a' "${INSTALLED_UPDATER}")" == "root:root:755" ]]
cmp deploy/root/update-vzn-activity-tracker "${INSTALLED_UPDATER}"

printf 'tampered after staging\n' > "${frontend_archive}"
expected_frontend_digest="$(awk '{print $1}' "${frontend_archive}.sha256")"
staged_frontend_digest="$(sudo sha256sum "${STAGING_ROOT}/frontend/$(basename "${frontend_archive}")" | awk '{print $1}')"
[[ "${staged_frontend_digest}" == "${expected_frontend_digest}" ]]
