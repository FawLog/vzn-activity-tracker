#!/bin/bash
set -Eeuo pipefail

umask 027
export PATH="/usr/sbin:/usr/bin:/sbin:/bin"
unset BASH_ENV CDPATH COMPOSE_FILE COMPOSE_PROJECT_NAME DOCKER_CONTEXT DOCKER_HOST ENV PYTHONHOME PYTHONPATH

readonly STAGING_ROOT="/var/lib/vzn-deploy-staging"
readonly SOURCE_ROOT="${STAGING_ROOT}/source"
readonly FRONTEND_ROOT="${STAGING_ROOT}/frontend"
readonly BACKEND_ROOT="${STAGING_ROOT}/backend"
readonly APP_ROOT="/srv/vzn-activity-tracker"
readonly NGINX_AVAILABLE="/etc/nginx/sites-available/vzn.fawlog.cc"
readonly NGINX_ENABLED="/etc/nginx/sites-enabled/vzn.fawlog.cc"
readonly BACKUP_ROOT="/var/backups/vzn-activity-tracker"
readonly HOST_CONFIG="/etc/vzn-activity-tracker/deploy.conf"
readonly CONTAINER_NAME="vzn-activity-tracker-backend"
readonly HEALTHCHECK_HELPER="/usr/local/lib/vzn-activity-tracker/healthcheck.sh"
readonly MINIMUM_RESERVE_BYTES=2147483648
readonly INSTALL_OVERHEAD_BYTES=268435456
readonly HTTPS_HEALTH_MAX_ATTEMPTS=15
readonly HTTPS_CONNECT_TIMEOUT_SECONDS=3
readonly HTTPS_REQUEST_TIMEOUT_SECONDS=5
readonly HTTPS_RETRY_DELAY_SECONDS=1

runtime_root=""
release_id=""
release_backup_root=""
transaction_started=0
install_completed=0

fail() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "Required command is unavailable: $1"
}

require_file() {
  [[ -f "$1" ]] || fail "Required file is missing: $1"
}

load_healthcheck_helper() {
  require_file "${HEALTHCHECK_HELPER}"
  [[ ! -L "${HEALTHCHECK_HELPER}" ]] || fail "Health-check helper must not be a symlink"
  [[ "$(stat --format='%U:%G:%a' "${HEALTHCHECK_HELPER}")" == "root:root:755" ]] || \
    fail "Health-check helper must be root:root mode 0755"
  # shellcheck source=/usr/local/lib/vzn-activity-tracker/healthcheck.sh
  source "${HEALTHCHECK_HELPER}"
}

validate_root_owned_directory() {
  local target="$1"
  local owner permissions
  [[ -d "${target}" ]] || fail "Required directory is missing: ${target}"
  owner="$(stat --format='%U:%G' "${target}")"
  permissions="$(stat --format='%a' "${target}")"
  [[ "${owner}" == "root:root" ]] || fail "Directory must be root:root: ${target}"
  (( (8#${permissions} & 0022) == 0 )) || fail "Directory must not be group/world writable: ${target}"
  if find "${target}" -xdev \( ! -user root -o ! -group root -o -perm /022 \) -print -quit | grep -q .; then
    fail "Staging content must be root:root and not group/world writable: ${target}"
  fi
}

archive_payload_bytes() {
  python3 - "$@" <<'PY'
from pathlib import PurePosixPath
import sys
import tarfile

sizes = []
for archive in sys.argv[1:]:
    with tarfile.open(archive, mode="r:gz") as bundle:
        members = bundle.getmembers()
        if not members:
            raise SystemExit(f"archive is empty: {archive}")
        for member in members:
            path = PurePosixPath(member.name)
            if path.is_absolute() or ".." in path.parts:
                raise SystemExit(f"unsafe archive path: {member.name}")
            if not (member.isdir() or member.isfile()):
                raise SystemExit(f"unsupported archive member: {member.name}")
        sizes.append(sum(member.size for member in members if member.isfile()))
print(*sizes)
PY
}

read_config_value() {
  local key="$1"
  local count value
  count="$(grep -cE "^${key}=" "${HOST_CONFIG}" || true)"
  [[ "${count}" == "1" ]] || fail "Host config must define ${key} exactly once"
  value="$(sed -n "s/^${key}=//p" "${HOST_CONFIG}")"
  [[ -n "${value}" && "${value}" != *$'\n'* && "${value}" != *$'\r'* ]] || \
    fail "Host config value is invalid: ${key}"
  printf '%s' "${value}"
}

render_nginx_config() {
  local template="$1"
  local output="$2"
  python3 - "${template}" "${output}" "${public_ipv4}" "${certificate_fullchain}" \
    "${certificate_private_key}" <<'PY'
from pathlib import Path
import sys

template_path, output_path, public_ipv4, fullchain, private_key = sys.argv[1:]
content = Path(template_path).read_text(encoding="utf-8")
replacements = {
    "__VZN_PUBLIC_IPV4__": public_ipv4,
    "__VZN_CERTIFICATE_FULLCHAIN__": fullchain,
    "__VZN_CERTIFICATE_PRIVATE_KEY__": private_key,
}
for placeholder, value in replacements.items():
    if placeholder not in content:
        raise SystemExit(f"missing Nginx placeholder: {placeholder}")
    content = content.replace(placeholder, value)
if "__VZN_" in content:
    raise SystemExit("unresolved Nginx placeholder")
Path(output_path).write_text(content, encoding="utf-8")
PY
}

wait_for_health() {
  local attempt
  for attempt in {1..30}; do
    if curl --fail --silent --show-error http://127.0.0.1:8088/api/v1/health; then
      printf '\n'
      return 0
    fi
    sleep 2
  done
  docker compose --project-directory "${APP_ROOT}" logs --tail=100 backend || true
  fail "VZN backend did not become healthy"
}

move_vzn_nginx_to() {
  local destination="$1"
  if [[ -e "${NGINX_ENABLED}" || -L "${NGINX_ENABLED}" ]]; then
    [[ -L "${NGINX_ENABLED}" ]] || return 1
    [[ "$(readlink "${NGINX_ENABLED}")" == "${NGINX_AVAILABLE}" ]] || return 1
    mv -T "${NGINX_ENABLED}" "${destination}/nginx-enabled"
  fi
  if [[ -e "${NGINX_AVAILABLE}" || -L "${NGINX_AVAILABLE}" ]]; then
    [[ -f "${NGINX_AVAILABLE}" && ! -L "${NGINX_AVAILABLE}" ]] || return 1
    [[ "$(stat --format='%U:%G' "${NGINX_AVAILABLE}")" == "root:root" ]] || return 1
    mv -T "${NGINX_AVAILABLE}" "${destination}/nginx-available"
  fi
}

restore_vzn_nginx_from() {
  local source="$1"
  if [[ -e "${source}/nginx-available" ]]; then
    mv -T "${source}/nginx-available" "${NGINX_AVAILABLE}"
  fi
  if [[ -e "${source}/nginx-enabled" || -L "${source}/nginx-enabled" ]]; then
    mv -T "${source}/nginx-enabled" "${NGINX_ENABLED}"
  fi
}

recover_interrupted_install() {
  local marker marker_commit marker_release recovery_root
  [[ -e "${APP_ROOT}" || -L "${APP_ROOT}" ]] || return 0

  marker="${APP_ROOT}/.vzn-installing"
  [[ -d "${APP_ROOT}" && ! -L "${APP_ROOT}" ]] || \
    fail "Application root exists but is not a recoverable directory: ${APP_ROOT}"
  require_file "${marker}"
  [[ ! -L "${marker}" ]] || fail "Interrupted-install marker must not be a symlink"
  [[ "$(stat --format='%U:%G:%a' "${marker}")" == "root:root:600" ]] || \
    fail "Interrupted-install marker has unexpected ownership or mode"
  [[ "$(grep -c '^COMMIT=' "${marker}" || true)" == "1" ]] || fail "Invalid interrupted-install marker"
  [[ "$(grep -c '^RELEASE_ID=' "${marker}" || true)" == "1" ]] || fail "Invalid interrupted-install marker"
  marker_commit="$(sed -n 's/^COMMIT=//p' "${marker}")"
  marker_release="$(sed -n 's/^RELEASE_ID=//p' "${marker}")"
  [[ "${marker_commit}" == "${commit}" ]] || \
    fail "Interrupted installation belongs to another commit; manual review is required"
  [[ "${marker_release}" =~ ^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{12}$ ]] || \
    fail "Interrupted-install release identifier is invalid"

  if [[ -e "${NGINX_ENABLED}" || -L "${NGINX_ENABLED}" ]]; then
    [[ -L "${NGINX_ENABLED}" && "$(readlink "${NGINX_ENABLED}")" == "${NGINX_AVAILABLE}" ]] || \
      fail "Unexpected Nginx enabled target blocks interrupted-install recovery"
  fi
  if [[ -e "${NGINX_AVAILABLE}" || -L "${NGINX_AVAILABLE}" ]]; then
    [[ -f "${NGINX_AVAILABLE}" && ! -L "${NGINX_AVAILABLE}" ]] || \
      fail "Unexpected Nginx available target blocks interrupted-install recovery"
    [[ "$(stat --format='%U:%G' "${NGINX_AVAILABLE}")" == "root:root" ]] || \
      fail "Unexpected Nginx config ownership blocks interrupted-install recovery"
  fi

  if [[ -f "${APP_ROOT}/compose.yaml" && -f "${APP_ROOT}/.env" ]]; then
    docker compose --project-directory "${APP_ROOT}" down --remove-orphans
  elif docker container inspect "${CONTAINER_NAME}" >/dev/null 2>&1; then
    fail "The interrupted VZN container exists without recoverable Compose metadata"
  fi

  install -d -o root -g root -m 0750 "${BACKUP_ROOT}"
  recovery_root="$(mktemp -d "${BACKUP_ROOT}/interrupted-${marker_release}.XXXXXX")"
  chmod 0700 "${recovery_root}"
  if ! move_vzn_nginx_to "${recovery_root}"; then
    restore_vzn_nginx_from "${recovery_root}" || true
    fail "Unable to isolate interrupted VZN Nginx files"
  fi
  if ! nginx -t || ! systemctl reload nginx; then
    restore_vzn_nginx_from "${recovery_root}" || true
    nginx -t || true
    systemctl reload nginx || true
    fail "Unable to restore Nginx while recovering an interrupted installation"
  fi
  mv -T "${APP_ROOT}" "${recovery_root}/app-root"
  if [[ -d "${BACKUP_ROOT}/${marker_release}" ]]; then
    mv -T "${BACKUP_ROOT}/${marker_release}" "${recovery_root}/release-backup"
  fi
  printf 'Recovered interrupted VZN installation into %s. Starting a clean attempt.\n' "${recovery_root}"
}

rollback_install() {
  local recovery_root compose_stopped=1
  set +e
  install -d -o root -g root -m 0750 "${BACKUP_ROOT}"
  recovery_root="$(mktemp -d "${BACKUP_ROOT}/failed-${release_id}.XXXXXX")"
  if [[ -z "${recovery_root}" || ! -d "${recovery_root}" ]]; then
    printf 'ERROR: Could not create a recovery directory; partial VZN state remains in place.\n' >&2
    return
  fi
  chmod 0700 "${recovery_root}"
  printf 'Installation failed; isolating only VZN state in %s.\n' "${recovery_root}" >&2

  if [[ -f "${APP_ROOT}/compose.yaml" && -f "${APP_ROOT}/.env" ]]; then
    docker compose --project-directory "${APP_ROOT}" down --remove-orphans || compose_stopped=0
  elif docker container inspect "${CONTAINER_NAME}" >/dev/null 2>&1; then
    compose_stopped=0
  fi

  if ! move_vzn_nginx_to "${recovery_root}"; then
    printf 'ERROR: VZN Nginx files could not be isolated automatically.\n' >&2
  else
    if ! nginx -t || ! systemctl reload nginx; then
      printf 'ERROR: Nginx rollback validation or reload failed; restoring VZN files.\n' >&2
      restore_vzn_nginx_from "${recovery_root}" || true
      nginx -t || true
      systemctl reload nginx || true
    fi
  fi

  if (( compose_stopped == 1 )) && [[ -d "${APP_ROOT}" && ! -L "${APP_ROOT}" ]]; then
    mv -T "${APP_ROOT}" "${recovery_root}/app-root" || true
  elif [[ -e "${APP_ROOT}" || -L "${APP_ROOT}" ]]; then
    printf 'ERROR: VZN container could not be stopped; application root remains for a safe retry.\n' >&2
  fi
  if [[ -n "${release_backup_root}" && -d "${release_backup_root}" ]]; then
    mv -T "${release_backup_root}" "${recovery_root}/release-backup" || true
  fi
  printf 'The prebuilt Docker image may remain cached; no unrelated image, volume, or service was changed.\n' >&2
}

on_exit() {
  local exit_code="$?"
  trap - EXIT INT TERM
  if (( exit_code != 0 && transaction_started == 1 && install_completed == 0 )); then
    rollback_install
  fi
  if [[ "${runtime_root}" == /run/vzn-install.* && -d "${runtime_root}" ]]; then
    rm -rf -- "${runtime_root}"
  fi
  exit "${exit_code}"
}

trap on_exit EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

[[ "${EUID}" -eq 0 ]] || fail "Run this installer as root"
[[ "$#" -eq 0 ]] || fail "This installer accepts no arguments"

for command_name in curl df docker du find grep install nginx openssl python3 sha256sum ss stat systemctl tar; do
  require_command "${command_name}"
done
load_healthcheck_helper

validate_root_owned_directory "${STAGING_ROOT}"
validate_root_owned_directory "${SOURCE_ROOT}"
validate_root_owned_directory "${FRONTEND_ROOT}"
validate_root_owned_directory "${BACKEND_ROOT}"
require_file "${HOST_CONFIG}"
[[ ! -L "${HOST_CONFIG}" ]] || fail "Host config must not be a symlink"
[[ "$(stat --format='%U:%G:%a' "${HOST_CONFIG}")" == "root:root:600" ]] || \
  fail "Host config must be root:root mode 0600"

public_ipv4="$(read_config_value VZN_PUBLIC_IPV4)"
certificate_fullchain="$(read_config_value VZN_CERTIFICATE_FULLCHAIN)"
certificate_private_key="$(read_config_value VZN_CERTIFICATE_PRIVATE_KEY)"
python3 - "${public_ipv4}" <<'PY'
import ipaddress
import sys

address = ipaddress.ip_address(sys.argv[1])
if address.version != 4:
    raise SystemExit("VZN_PUBLIC_IPV4 must be an IPv4 address")
PY
[[ "${certificate_fullchain}" == /* && "${certificate_private_key}" == /* ]] || \
  fail "Certificate paths must be absolute"
require_file "${certificate_fullchain}"
require_file "${certificate_private_key}"

[[ "$(systemctl is-active docker)" == "active" ]] || fail "Docker is not active"
[[ "$(systemctl is-enabled docker)" == "enabled" ]] || fail "Docker is not enabled at boot"
[[ "$(systemctl is-active nginx)" == "active" ]] || fail "Nginx is not active"
[[ "$(systemctl is-enabled nginx)" == "enabled" ]] || fail "Nginx is not enabled at boot"
docker compose version >/dev/null
nginx -t
openssl x509 -in "${certificate_fullchain}" -checkend 86400 -noout
certificate_sans="$(openssl x509 -in "${certificate_fullchain}" -noout -ext subjectAltName)"
grep -Fq 'DNS:*.fawlog.cc' <<< "${certificate_sans}" || \
  fail "Wildcard certificate does not cover vzn.fawlog.cc"
certificate_public_key="$(openssl x509 -in "${certificate_fullchain}" -pubkey -noout | sha256sum | awk '{print $1}')"
private_public_key="$(openssl pkey -in "${certificate_private_key}" -pubout 2>/dev/null | sha256sum | awk '{print $1}')"
[[ "${certificate_public_key}" == "${private_public_key}" ]] || fail "Certificate and private key do not match"

require_file "${SOURCE_ROOT}/REVISION"
require_file "${SOURCE_ROOT}/compose.yaml"
require_file "${SOURCE_ROOT}/scripts/init_env.py"
require_file "${SOURCE_ROOT}/backend/app/security.py"
require_file "${SOURCE_ROOT}/deploy/nginx/vzn.fawlog.cc.conf"

mapfile -t frontend_archives < <(find "${FRONTEND_ROOT}" -maxdepth 1 -type f -name 'vzn-frontend-*.tar.gz' -print)
mapfile -t backend_archives < <(find "${BACKEND_ROOT}" -maxdepth 1 -type f -name 'vzn-backend-*.tar.gz' -print)
mapfile -t backend_manifests < <(find "${BACKEND_ROOT}" -maxdepth 1 -type f -name 'vzn-backend-*.manifest' -print)
[[ "${#frontend_archives[@]}" -eq 1 ]] || fail "Expected exactly one frontend archive"
[[ "${#backend_archives[@]}" -eq 1 ]] || fail "Expected exactly one backend archive"
[[ "${#backend_manifests[@]}" -eq 1 ]] || fail "Expected exactly one backend manifest"

frontend_archive="${frontend_archives[0]}"
backend_archive="${backend_archives[0]}"
backend_manifest="${backend_manifests[0]}"
require_file "${frontend_archive}.sha256"
require_file "${backend_archive}.sha256"
(cd "${FRONTEND_ROOT}" && sha256sum --check "$(basename "${frontend_archive}.sha256")")
(cd "${BACKEND_ROOT}" && sha256sum --check "$(basename "${backend_archive}.sha256")")
read -r frontend_payload_bytes backend_payload_bytes < <(archive_payload_bytes "${frontend_archive}" "${backend_archive}")

commit="$(sed -n 's/^GIT_COMMIT=//p' "${backend_manifest}")"
image_tag="$(sed -n 's/^VZN_IMAGE_TAG=//p' "${backend_manifest}")"
source_commit="$(tr -d '\r\n' < "${SOURCE_ROOT}/REVISION")"
[[ "${commit}" =~ ^[0-9a-f]{40}$ ]] || fail "Backend manifest has an invalid commit"
[[ "${source_commit}" == "${commit}" ]] || fail "Source and backend commits differ"
[[ "${image_tag}" == "ci-${commit}" ]] || fail "Backend image tag does not match the commit"
[[ "$(basename "${frontend_archive}")" == "vzn-frontend-${commit}.tar.gz" ]] || \
  fail "Frontend artifact does not match the commit"
[[ "$(basename "${backend_archive}")" == "vzn-backend-${commit}.tar.gz" ]] || \
  fail "Backend artifact does not match the commit"

recover_interrupted_install

[[ ! -e "${APP_ROOT}" && ! -L "${APP_ROOT}" ]] || fail "Application root already exists: ${APP_ROOT}"
[[ ! -e "${NGINX_AVAILABLE}" && ! -L "${NGINX_AVAILABLE}" ]] || \
  fail "Nginx target already exists: ${NGINX_AVAILABLE}"
[[ ! -e "${NGINX_ENABLED}" && ! -L "${NGINX_ENABLED}" ]] || fail "Nginx target is already enabled"
[[ -z "$(ss -H -ltn 'sport = :8088')" ]] || fail "Loopback port 8088 is already in use"
if docker container inspect "${CONTAINER_NAME}" >/dev/null 2>&1; then
  fail "VZN container name is already in use: ${CONTAINER_NAME}"
fi

available_bytes="$(df --output=avail --block-size=1 / | tail -n 1 | tr -d ' ')"
source_bytes="$(du -sb -- "${SOURCE_ROOT}" | awk '{print $1}')"
[[ "${available_bytes}" =~ ^[0-9]+$ && "${source_bytes}" =~ ^[0-9]+$ ]] || \
  fail "Unable to determine disk usage"
estimated_peak_bytes=$((backend_payload_bytes * 3 + frontend_payload_bytes + source_bytes + INSTALL_OVERHEAD_BYTES))
required_available_bytes=$((MINIMUM_RESERVE_BYTES + estimated_peak_bytes))
printf 'Disk preflight: available=%s bytes, conservative peak=%s bytes, required=%s bytes (includes 2 GiB reserve).\n' \
  "${available_bytes}" "${estimated_peak_bytes}" "${required_available_bytes}"
(( available_bytes >= required_available_bytes )) || \
  fail "Insufficient disk space for the conservative installation peak and 2 GiB post-install reserve"

release_id="$(date -u +%Y%m%dT%H%M%SZ)-${commit:0:12}"
release_root="${APP_ROOT}/releases/${release_id}"
release_backup_root="${BACKUP_ROOT}/${release_id}"
runtime_root="$(mktemp -d /run/vzn-install.XXXXXX)"
chmod 0700 "${runtime_root}"
pending_env="${runtime_root}/pending.env"
rendered_nginx="${runtime_root}/vzn.fawlog.cc.conf"

python3 "${SOURCE_ROOT}/scripts/init_env.py" \
  --domain vzn.fawlog.cc --image-tag "${image_tag}" --output "${pending_env}"
render_nginx_config "${SOURCE_ROOT}/deploy/nginx/vzn.fawlog.cc.conf" "${rendered_nginx}"

transaction_started=1
install -d -o root -g root -m 0750 "${BACKUP_ROOT}" "${release_backup_root}"
install -d -o root -g root -m 0755 "${APP_ROOT}" "${APP_ROOT}/releases" "${release_root}/frontend"
printf 'COMMIT=%s\nRELEASE_ID=%s\n' "${commit}" "${release_id}" > "${APP_ROOT}/.vzn-installing"
chown root:root "${APP_ROOT}/.vzn-installing"
chmod 0600 "${APP_ROOT}/.vzn-installing"
install -d -o 10001 -g 10001 -m 0750 "${APP_ROOT}/data" "${APP_ROOT}/data/backups"
install -o root -g root -m 0644 "${SOURCE_ROOT}/compose.yaml" "${APP_ROOT}/compose.yaml"
cp --archive "${SOURCE_ROOT}/scripts" "${APP_ROOT}/scripts"
cp --archive "${SOURCE_ROOT}/backend" "${APP_ROOT}/backend"
chown -R root:root "${APP_ROOT}/scripts" "${APP_ROOT}/backend"
install -o root -g root -m 0600 "${pending_env}" "${APP_ROOT}/.env"

tar --extract --gzip --file "${frontend_archive}" --directory "${release_root}/frontend" \
  --no-same-owner --no-same-permissions
find "${release_root}" -type d -exec chmod 0755 {} +
find "${release_root}" -type f -exec chmod 0644 {} +
chown -R root:root "${release_root}"
ln -s "${release_root}" "${APP_ROOT}/current.next"
mv -T "${APP_ROOT}/current.next" "${APP_ROOT}/current"

docker load --input "${backend_archive}"
docker image inspect "vzn-activity-tracker-backend:${image_tag}" >/dev/null
docker compose --project-directory "${APP_ROOT}" up --detach --no-build backend
wait_for_health

install -o root -g root -m 0644 "${rendered_nginx}" "${NGINX_AVAILABLE}"
ln -s "${NGINX_AVAILABLE}" "${NGINX_ENABLED}"
nginx -t
systemctl reload nginx

wait_for_public_https_health "vzn.fawlog.cc" "${public_ipv4}" \
  "${HTTPS_HEALTH_MAX_ATTEMPTS}" "${HTTPS_CONNECT_TIMEOUT_SECONDS}" \
  "${HTTPS_REQUEST_TIMEOUT_SECONDS}" "${HTTPS_RETRY_DELAY_SECONDS}" || \
  fail "Public HTTPS health check did not become ready"
docker compose --project-directory "${APP_ROOT}" ps
rm -f "${APP_ROOT}/.vzn-installing"
install_completed=1
printf 'Installed VZN release %s from commit %s.\n' "${release_id}" "${commit}"
