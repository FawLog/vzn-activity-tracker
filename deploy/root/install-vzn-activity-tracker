#!/bin/bash
set -Eeuo pipefail

umask 027
export PATH="/usr/sbin:/usr/bin:/sbin:/bin"
unset BASH_ENV CDPATH COMPOSE_FILE COMPOSE_PROJECT_NAME DOCKER_CONTEXT DOCKER_HOST ENV PYTHONHOME PYTHONPATH

readonly STAGING_ROOT="/var/lib/vzn-deploy-staging"
readonly SOURCE_ROOT="${STAGING_ROOT}/source"
readonly FRONTEND_ROOT="${STAGING_ROOT}/frontend"
readonly BACKEND_ROOT="${STAGING_ROOT}/backend"
readonly APP_ROOT="/srv/vzn-activity-tracker"
readonly NGINX_AVAILABLE="/etc/nginx/sites-available/vzn.fawlog.cc"
readonly NGINX_ENABLED="/etc/nginx/sites-enabled/vzn.fawlog.cc"
readonly BACKUP_ROOT="/var/backups/vzn-activity-tracker"
readonly HOST_CONFIG="/etc/vzn-activity-tracker/deploy.conf"
readonly MINIMUM_FREE_BYTES=2147483648

fail() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "Required command is unavailable: $1"
}

require_file() {
  [[ -f "$1" ]] || fail "Required file is missing: $1"
}

validate_root_owned_directory() {
  local target="$1"
  local owner permissions
  [[ -d "${target}" ]] || fail "Required directory is missing: ${target}"
  owner="$(stat --format='%U:%G' "${target}")"
  permissions="$(stat --format='%a' "${target}")"
  [[ "${owner}" == "root:root" ]] || fail "Directory must be root:root: ${target}"
  (( (8#${permissions} & 0022) == 0 )) || fail "Directory must not be group/world writable: ${target}"
  if find "${target}" -xdev \( ! -user root -o ! -group root -o -perm /022 \) -print -quit | grep -q .; then
    fail "Staging content must be root:root and not group/world writable: ${target}"
  fi
}

validate_frontend_archive() {
  local archive="$1"
  python3 - "${archive}" <<'PY'
from pathlib import PurePosixPath
import sys
import tarfile

archive = sys.argv[1]
with tarfile.open(archive, mode="r:gz") as bundle:
    members = bundle.getmembers()
    if not members:
        raise SystemExit("frontend archive is empty")
    for member in members:
        path = PurePosixPath(member.name)
        if path.is_absolute() or ".." in path.parts:
            raise SystemExit(f"unsafe archive path: {member.name}")
        if not (member.isdir() or member.isfile()):
            raise SystemExit(f"unsupported archive member: {member.name}")
PY
}

read_config_value() {
  local key="$1"
  local count value
  count="$(grep -cE "^${key}=" "${HOST_CONFIG}" || true)"
  [[ "${count}" == "1" ]] || fail "Host config must define ${key} exactly once"
  value="$(sed -n "s/^${key}=//p" "${HOST_CONFIG}")"
  [[ -n "${value}" && "${value}" != *$'\n'* && "${value}" != *$'\r'* ]] || \
    fail "Host config value is invalid: ${key}"
  printf '%s' "${value}"
}

render_nginx_config() {
  local template="$1"
  local output="$2"
  python3 - "${template}" "${output}" "${public_ipv4}" "${certificate_fullchain}" \
    "${certificate_private_key}" <<'PY'
from pathlib import Path
import sys

template_path, output_path, public_ipv4, fullchain, private_key = sys.argv[1:]
content = Path(template_path).read_text(encoding="utf-8")
replacements = {
    "__VZN_PUBLIC_IPV4__": public_ipv4,
    "__VZN_CERTIFICATE_FULLCHAIN__": fullchain,
    "__VZN_CERTIFICATE_PRIVATE_KEY__": private_key,
}
for placeholder, value in replacements.items():
    if placeholder not in content:
        raise SystemExit(f"missing Nginx placeholder: {placeholder}")
    content = content.replace(placeholder, value)
if "__VZN_" in content:
    raise SystemExit("unresolved Nginx placeholder")
Path(output_path).write_text(content, encoding="utf-8")
PY
}

wait_for_health() {
  local attempt
  for attempt in {1..30}; do
    if curl --fail --silent --show-error http://127.0.0.1:8088/api/v1/health; then
      printf '\n'
      return 0
    fi
    sleep 2
  done
  docker compose --project-directory "${APP_ROOT}" logs --tail=100 backend || true
  fail "VZN backend did not become healthy"
}

[[ "${EUID}" -eq 0 ]] || fail "Run this installer as root"
[[ "$#" -eq 0 ]] || fail "This installer accepts no arguments"

for command_name in curl docker find grep install nginx openssl python3 sha256sum ss stat systemctl tar; do
  require_command "${command_name}"
done

validate_root_owned_directory "${STAGING_ROOT}"
validate_root_owned_directory "${SOURCE_ROOT}"
validate_root_owned_directory "${FRONTEND_ROOT}"
validate_root_owned_directory "${BACKEND_ROOT}"
require_file "${HOST_CONFIG}"
[[ "$(stat --format='%U:%G:%a' "${HOST_CONFIG}")" == "root:root:600" ]] || \
  fail "Host config must be root:root mode 0600"

public_ipv4="$(read_config_value VZN_PUBLIC_IPV4)"
certificate_fullchain="$(read_config_value VZN_CERTIFICATE_FULLCHAIN)"
certificate_private_key="$(read_config_value VZN_CERTIFICATE_PRIVATE_KEY)"
python3 - "${public_ipv4}" <<'PY'
import ipaddress
import sys

address = ipaddress.ip_address(sys.argv[1])
if address.version != 4:
    raise SystemExit("VZN_PUBLIC_IPV4 must be an IPv4 address")
PY
[[ "${certificate_fullchain}" == /* && "${certificate_private_key}" == /* ]] || \
  fail "Certificate paths must be absolute"
require_file "${certificate_fullchain}"
require_file "${certificate_private_key}"

[[ ! -e "${APP_ROOT}" ]] || fail "Application root already exists: ${APP_ROOT}"
[[ ! -e "${NGINX_AVAILABLE}" ]] || fail "Nginx target already exists: ${NGINX_AVAILABLE}"
[[ ! -e "${NGINX_ENABLED}" && ! -L "${NGINX_ENABLED}" ]] || fail "Nginx target is already enabled"
[[ -z "$(ss -H -ltn 'sport = :8088')" ]] || fail "Loopback port 8088 is already in use"
[[ "$(systemctl is-active docker)" == "active" ]] || fail "Docker is not active"
[[ "$(systemctl is-enabled docker)" == "enabled" ]] || fail "Docker is not enabled at boot"
[[ "$(systemctl is-active nginx)" == "active" ]] || fail "Nginx is not active"
nginx -t
openssl x509 -in "${certificate_fullchain}" -checkend 86400 -noout
certificate_sans="$(openssl x509 -in "${certificate_fullchain}" -noout -ext subjectAltName)"
grep -Fq 'DNS:*.fawlog.cc' <<< "${certificate_sans}" || fail "Wildcard certificate does not cover vzn.fawlog.cc"

available_bytes="$(df --output=avail --block-size=1 / | tail -n 1 | tr -d ' ')"
[[ "${available_bytes}" =~ ^[0-9]+$ ]] || fail "Unable to determine free disk space"
(( available_bytes >= MINIMUM_FREE_BYTES )) || fail "At least 2 GiB of free disk space is required"

require_file "${SOURCE_ROOT}/REVISION"
require_file "${SOURCE_ROOT}/compose.yaml"
require_file "${SOURCE_ROOT}/scripts/init_env.py"
require_file "${SOURCE_ROOT}/backend/app/security.py"
require_file "${SOURCE_ROOT}/deploy/nginx/vzn.fawlog.cc.conf"

mapfile -t frontend_archives < <(find "${FRONTEND_ROOT}" -maxdepth 1 -type f -name 'vzn-frontend-*.tar.gz' -print)
mapfile -t backend_archives < <(find "${BACKEND_ROOT}" -maxdepth 1 -type f -name 'vzn-backend-*.tar.gz' -print)
mapfile -t backend_manifests < <(find "${BACKEND_ROOT}" -maxdepth 1 -type f -name 'vzn-backend-*.manifest' -print)
[[ "${#frontend_archives[@]}" -eq 1 ]] || fail "Expected exactly one frontend archive"
[[ "${#backend_archives[@]}" -eq 1 ]] || fail "Expected exactly one backend archive"
[[ "${#backend_manifests[@]}" -eq 1 ]] || fail "Expected exactly one backend manifest"

frontend_archive="${frontend_archives[0]}"
backend_archive="${backend_archives[0]}"
backend_manifest="${backend_manifests[0]}"
require_file "${frontend_archive}.sha256"
require_file "${backend_archive}.sha256"

(cd "${FRONTEND_ROOT}" && sha256sum --check "$(basename "${frontend_archive}.sha256")")
(cd "${BACKEND_ROOT}" && sha256sum --check "$(basename "${backend_archive}.sha256")")
validate_frontend_archive "${frontend_archive}"

commit="$(sed -n 's/^GIT_COMMIT=//p' "${backend_manifest}")"
image_tag="$(sed -n 's/^VZN_IMAGE_TAG=//p' "${backend_manifest}")"
source_commit="$(tr -d '\r\n' < "${SOURCE_ROOT}/REVISION")"
[[ "${commit}" =~ ^[0-9a-f]{40}$ ]] || fail "Backend manifest has an invalid commit"
[[ "${source_commit}" == "${commit}" ]] || fail "Source and backend commits differ"
[[ "${image_tag}" == "ci-${commit}" ]] || fail "Backend image tag does not match the commit"
[[ "$(basename "${frontend_archive}")" == "vzn-frontend-${commit}.tar.gz" ]] || fail "Frontend artifact does not match the commit"
[[ "$(basename "${backend_archive}")" == "vzn-backend-${commit}.tar.gz" ]] || fail "Backend artifact does not match the commit"

release_id="$(date -u +%Y%m%dT%H%M%SZ)-${commit:0:12}"
release_root="${APP_ROOT}/releases/${release_id}"
backup_root="${BACKUP_ROOT}/${release_id}"

install -d -o root -g root -m 0750 "${backup_root}"
install -d -o root -g root -m 0755 "${APP_ROOT}" "${APP_ROOT}/releases" "${release_root}/frontend"
install -d -o 10001 -g 10001 -m 0750 "${APP_ROOT}/data" "${APP_ROOT}/data/backups"
install -o root -g root -m 0644 "${SOURCE_ROOT}/compose.yaml" "${APP_ROOT}/compose.yaml"
cp --archive "${SOURCE_ROOT}/scripts" "${APP_ROOT}/scripts"
cp --archive "${SOURCE_ROOT}/backend" "${APP_ROOT}/backend"
chown -R root:root "${APP_ROOT}/scripts" "${APP_ROOT}/backend"

tar --extract --gzip --file "${frontend_archive}" --directory "${release_root}/frontend" --no-same-owner --no-same-permissions
find "${release_root}" -type d -exec chmod 0755 {} +
find "${release_root}" -type f -exec chmod 0644 {} +
chown -R root:root "${release_root}"
ln -s "${release_root}" "${APP_ROOT}/current.next"
mv -T "${APP_ROOT}/current.next" "${APP_ROOT}/current"

docker load --input "${backend_archive}"
docker image inspect "vzn-activity-tracker-backend:${image_tag}" >/dev/null

cd "${APP_ROOT}"
python3 scripts/init_env.py --domain vzn.fawlog.cc --image-tag "${image_tag}"
chown root:root .env
chmod 0600 .env

docker compose --project-directory "${APP_ROOT}" up --detach --no-build backend
wait_for_health

rendered_nginx="$(mktemp)"
trap 'rm -f "${rendered_nginx}"' EXIT
render_nginx_config "${SOURCE_ROOT}/deploy/nginx/vzn.fawlog.cc.conf" "${rendered_nginx}"
install -o root -g root -m 0644 "${rendered_nginx}" "${NGINX_AVAILABLE}"
rm -f "${rendered_nginx}"
trap - EXIT
ln -s "${NGINX_AVAILABLE}" "${NGINX_ENABLED}"
if ! nginx -t; then
  rm -f "${NGINX_ENABLED}" "${NGINX_AVAILABLE}"
  nginx -t || true
  fail "New Nginx configuration failed validation and was removed"
fi
systemctl reload nginx

docker compose --project-directory "${APP_ROOT}" ps
curl --fail --silent --show-error --resolve "vzn.fawlog.cc:443:${public_ipv4}" \
  https://vzn.fawlog.cc/api/v1/health
printf '\nInstalled VZN release %s from commit %s.\n' "${release_id}" "${commit}"
