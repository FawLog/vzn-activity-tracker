#!/bin/bash
set -Eeuo pipefail

umask 027
export PATH="/usr/sbin:/usr/bin:/sbin:/bin"
unset BASH_ENV CDPATH ENV PYTHONHOME PYTHONPATH

readonly DEPLOYER="/usr/local/sbin/vzn-deploy"

fail() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

[[ "${EUID}" -eq 0 ]] || fail "Run this helper as root"
[[ "$#" -eq 1 ]] || fail "Usage: manage-vzn-sudoers grant|revoke"
requesting_user="${SUDO_USER:-}"
[[ "${requesting_user}" =~ ^[a-z_][a-z0-9_-]*$ ]] || fail "A valid invoking SUDO_USER is required"
id "${requesting_user}" >/dev/null 2>&1 || fail "Invoking user does not exist"
readonly RULE="/etc/sudoers.d/vzn-deploy-${requesting_user}"

case "$1" in
  grant)
    [[ -f "${DEPLOYER}" ]] || fail "Root-owned deployer is missing"
    [[ "$(stat --format='%U:%G:%a' "${DEPLOYER}")" == "root:root:755" ]] || fail "Unexpected deployer ownership or mode"
    [[ ! -e "${RULE}" ]] || fail "Temporary sudoers rule already exists"
    digest="$(sha256sum "${DEPLOYER}" | awk '{print $1}')"
    temporary_rule="$(mktemp "/etc/sudoers.d/.vzn-deploy-${requesting_user}.XXXXXX")"
    trap 'rm -f "${temporary_rule}"' EXIT
    printf '%s ALL=(root) NOPASSWD: sha256:%s %s ""\n' \
      "${requesting_user}" "${digest}" "${DEPLOYER}" > "${temporary_rule}"
    chown root:root "${temporary_rule}"
    chmod 0440 "${temporary_rule}"
    visudo --check --file "${temporary_rule}"
    mv "${temporary_rule}" "${RULE}"
    trap - EXIT
    if ! visudo --check; then
      rm -f "${RULE}"
      visudo --check || true
      fail "Global sudoers validation failed; the temporary rule was removed"
    fi
    printf 'Granted temporary no-argument VZN deploy permission with SHA-256 %s.\n' "${digest}"
    ;;
  revoke)
    [[ -e "${RULE}" ]] || fail "Temporary sudoers rule is not installed"
    rm -f "${RULE}"
    visudo --check
    printf 'Revoked temporary VZN deploy permission.\n'
    ;;
  *)
    fail "Usage: manage-vzn-sudoers grant|revoke"
    ;;
esac
