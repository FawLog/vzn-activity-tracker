#!/bin/bash
set -Eeuo pipefail

umask 027
export PATH="/usr/sbin:/usr/bin:/sbin:/bin"
unset BASH_ENV CDPATH COMPOSE_FILE COMPOSE_PROJECT_NAME DOCKER_CONTEXT DOCKER_HOST ENV PYTHONHOME PYTHONPATH

readonly STAGING_ROOT="/var/lib/vzn-deploy-staging"
readonly UPDATE_STAGING_ROOT="/var/lib/vzn-update-staging"
readonly BACKUP_ROOT="/var/backups/vzn-activity-tracker"
readonly INSTALLED_DEPLOYER="/usr/local/sbin/vzn-deploy"
readonly INSTALLED_UPDATER="/usr/local/sbin/vzn-update"
readonly INSTALLED_SUDOERS_HELPER="/usr/local/sbin/vzn-manage-sudoers"
readonly INSTALLED_HEALTHCHECK_HELPER="/usr/local/lib/vzn-activity-tracker/healthcheck.sh"

staging_temp=""

cleanup() {
  local exit_code="$?"
  trap - EXIT INT TERM
  if [[ -n "${staging_temp}" && -d "${staging_temp}" ]]; then
    rm -rf -- "${staging_temp}"
  fi
  exit "${exit_code}"
}

trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

fail() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

validate_archive() {
  local archive="$1"
  python3 - "${archive}" <<'PY'
from pathlib import PurePosixPath
import sys
import tarfile

archive = sys.argv[1]
with tarfile.open(archive, mode="r:gz") as bundle:
    members = bundle.getmembers()
    if not members:
        raise SystemExit("archive is empty")
    for member in members:
        path = PurePosixPath(member.name)
        if path.is_absolute() or ".." in path.parts:
            raise SystemExit(f"unsafe archive path: {member.name}")
        if not (member.isdir() or member.isfile()):
            raise SystemExit(f"unsupported archive member: {member.name}")
PY
}

[[ "${EUID}" -eq 0 ]] || fail "Run this staging helper as root"
case "$#:${1:-}" in
  1:*) mode="install"; artifact_argument="$1" ;;
  2:--update) mode="update"; artifact_argument="$2" ;;
  *) fail "Usage: stage-vzn-artifacts /absolute/path/to/artifacts | stage-vzn-artifacts --update /absolute/path/to/artifacts" ;;
esac

if [[ "${mode}" == "install" ]]; then
  staging_root="${STAGING_ROOT}"
  [[ ! -e "${staging_root}" ]] || fail "Staging root already exists: ${staging_root}"
  [[ ! -e "${INSTALLED_DEPLOYER}" ]] || fail "Installed deployer already exists: ${INSTALLED_DEPLOYER}"
  [[ ! -e "${INSTALLED_SUDOERS_HELPER}" ]] || \
    fail "Installed sudoers helper already exists: ${INSTALLED_SUDOERS_HELPER}"
  [[ ! -e "${INSTALLED_HEALTHCHECK_HELPER}" ]] || \
    fail "Installed health-check helper already exists: ${INSTALLED_HEALTHCHECK_HELPER}"
else
  staging_root="${UPDATE_STAGING_ROOT}"
  if [[ -e "${staging_root}" || -L "${staging_root}" ]]; then
    [[ -d "${staging_root}" && ! -L "${staging_root}" ]] || \
      fail "Existing update staging root is unsafe: ${staging_root}"
    [[ "$(stat --format='%U:%G' "${staging_root}")" == "root:root" ]] || \
      fail "Existing update staging root must be root:root"
  fi
fi

artifact_root="$(realpath --canonicalize-existing "${artifact_argument}")"
[[ "${artifact_root}" == /* ]] || fail "Artifact root must resolve to an absolute path"
[[ "${artifact_root}" != "${STAGING_ROOT}" && "${artifact_root}" != "${STAGING_ROOT}/"* && \
  "${artifact_root}" != "${UPDATE_STAGING_ROOT}" && "${artifact_root}" != "${UPDATE_STAGING_ROOT}/"* ]] || \
  fail "Artifact input must be outside the root-owned staging directory"
for directory in frontend backend deployment; do
  [[ -d "${artifact_root}/${directory}" ]] || fail "Artifact directory is missing: ${directory}"
done

mapfile -t frontend_archives < <(find "${artifact_root}/frontend" -maxdepth 1 -type f -name 'vzn-frontend-*.tar.gz' -print)
mapfile -t backend_archives < <(find "${artifact_root}/backend" -maxdepth 1 -type f -name 'vzn-backend-*.tar.gz' -print)
mapfile -t backend_manifests < <(find "${artifact_root}/backend" -maxdepth 1 -type f -name 'vzn-backend-*.manifest' -print)
mapfile -t deployment_archives < <(find "${artifact_root}/deployment" -maxdepth 1 -type f -name 'vzn-deployment-*.tar.gz' -print)
[[ "${#frontend_archives[@]}" -eq 1 ]] || fail "Expected exactly one frontend archive"
[[ "${#backend_archives[@]}" -eq 1 ]] || fail "Expected exactly one backend archive"
[[ "${#backend_manifests[@]}" -eq 1 ]] || fail "Expected exactly one backend manifest"
[[ "${#deployment_archives[@]}" -eq 1 ]] || fail "Expected exactly one deployment archive"

frontend_archive="${frontend_archives[0]}"
backend_archive="${backend_archives[0]}"
backend_manifest="${backend_manifests[0]}"
deployment_archive="${deployment_archives[0]}"
for archive in "${frontend_archive}" "${backend_archive}" "${deployment_archive}"; do
  [[ -f "${archive}.sha256" ]] || fail "Checksum is missing: ${archive}.sha256"
done

staging_temp="$(mktemp -d "${staging_root}.tmp.XXXXXX")"
chmod 0750 "${staging_temp}"
install -d -o root -g root -m 0750 \
  "${staging_temp}/source" "${staging_temp}/frontend" "${staging_temp}/backend" \
  "${staging_temp}/deployment"
install -o root -g root -m 0640 \
  "${frontend_archive}" "${frontend_archive}.sha256" "${staging_temp}/frontend/"
install -o root -g root -m 0640 \
  "${backend_archive}" "${backend_archive}.sha256" "${backend_manifest}" "${staging_temp}/backend/"
install -o root -g root -m 0640 \
  "${deployment_archive}" "${deployment_archive}.sha256" "${staging_temp}/deployment/"

frontend_archive="${staging_temp}/frontend/$(basename "${frontend_archive}")"
backend_archive="${staging_temp}/backend/$(basename "${backend_archive}")"
backend_manifest="${staging_temp}/backend/$(basename "${backend_manifest}")"
deployment_archive="${staging_temp}/deployment/$(basename "${deployment_archive}")"
for archive in "${frontend_archive}" "${backend_archive}" "${deployment_archive}"; do
  (cd "$(dirname "${archive}")" && sha256sum --check "$(basename "${archive}.sha256")")
done
validate_archive "${frontend_archive}"
validate_archive "${deployment_archive}"

commit="$(sed -n 's/^GIT_COMMIT=//p' "${backend_manifest}")"
[[ "${commit}" =~ ^[0-9a-f]{40}$ ]] || fail "Backend manifest has an invalid commit"
[[ "$(basename "${frontend_archive}")" == "vzn-frontend-${commit}.tar.gz" ]] || fail "Frontend commit mismatch"
[[ "$(basename "${backend_archive}")" == "vzn-backend-${commit}.tar.gz" ]] || fail "Backend commit mismatch"
[[ "$(basename "${deployment_archive}")" == "vzn-deployment-${commit}.tar.gz" ]] || fail "Deployment commit mismatch"

tar --extract --gzip --file "${deployment_archive}" --directory "${staging_temp}/source" \
  --no-same-owner --no-same-permissions
chown -R root:root "${staging_temp}"
chmod -R go-w "${staging_temp}"

[[ "$(tr -d '\r\n' < "${staging_temp}/source/REVISION")" == "${commit}" ]] || \
  fail "Deployment source commit mismatch"
for required_source in \
  deploy/root/install-vzn-activity-tracker \
  deploy/root/update-vzn-activity-tracker \
  deploy/root/manage-vzn-sudoers \
  deploy/root/healthcheck.sh; do
  [[ -f "${staging_temp}/source/${required_source}" ]] || fail "Deployment source is missing: ${required_source}"
done
if [[ "${mode}" == "update" && -d "${staging_root}" ]]; then
  install -d -o root -g root -m 0750 "${BACKUP_ROOT}"
  archived_stage="${BACKUP_ROOT}/staged-update-$(date -u +%Y%m%dT%H%M%SZ)-${commit:0:12}"
  [[ ! -e "${archived_stage}" ]] || fail "Update staging archive target already exists"
  mv -T "${staging_root}" "${archived_stage}"
fi
mv -T "${staging_temp}" "${staging_root}"
staging_temp=""
if [[ "${mode}" == "install" ]]; then
  install -o root -g root -m 0755 \
    "${staging_root}/source/deploy/root/install-vzn-activity-tracker" "${INSTALLED_DEPLOYER}"
  printf 'Staged first-install commit %s. Root-owned deployer: %s\n' "${commit}" "${INSTALLED_DEPLOYER}"
  printf 'Deployer SHA-256: '
  sha256sum "${INSTALLED_DEPLOYER}" | awk '{print $1}'
else
  install -o root -g root -m 0755 \
    "${staging_root}/source/deploy/root/update-vzn-activity-tracker" "${INSTALLED_UPDATER}"
  printf 'Staged update commit %s. Root-owned updater: %s\n' "${commit}" "${INSTALLED_UPDATER}"
  printf 'Updater SHA-256: '
  sha256sum "${INSTALLED_UPDATER}" | awk '{print $1}'
fi
install -o root -g root -m 0755 \
  "${staging_root}/source/deploy/root/manage-vzn-sudoers" "${INSTALLED_SUDOERS_HELPER}"
install -d -o root -g root -m 0755 /usr/local/lib/vzn-activity-tracker
install -o root -g root -m 0755 \
  "${staging_root}/source/deploy/root/healthcheck.sh" "${INSTALLED_HEALTHCHECK_HELPER}"
