#!/bin/bash
set -Eeuo pipefail

umask 027
export PATH="/usr/sbin:/usr/bin:/sbin:/bin"
unset BASH_ENV CDPATH COMPOSE_FILE COMPOSE_PROJECT_NAME DOCKER_CONTEXT DOCKER_HOST ENV PYTHONHOME PYTHONPATH

readonly STAGING_ROOT="/var/lib/vzn-update-staging"
readonly SOURCE_ROOT="${STAGING_ROOT}/source"
readonly FRONTEND_ROOT="${STAGING_ROOT}/frontend"
readonly BACKEND_ROOT="${STAGING_ROOT}/backend"
readonly APP_ROOT="/srv/vzn-activity-tracker"
readonly BACKUP_ROOT="/var/backups/vzn-activity-tracker"
readonly HOST_CONFIG="/etc/vzn-activity-tracker/deploy.conf"
readonly CONTAINER_NAME="vzn-activity-tracker-backend"
readonly HEALTHCHECK_HELPER="/usr/local/lib/vzn-activity-tracker/healthcheck.sh"
readonly MINIMUM_RESERVE_BYTES=536870912
readonly UPDATE_OVERHEAD_BYTES=268435456
readonly HTTPS_HEALTH_MAX_ATTEMPTS=15
readonly HTTPS_CONNECT_TIMEOUT_SECONDS=3
readonly HTTPS_REQUEST_TIMEOUT_SECONDS=5
readonly HTTPS_RETRY_DELAY_SECONDS=1
readonly UPDATE_MARKER="${APP_ROOT}/.vzn-updating"

release_id=""
transaction_root=""
backup_container_path=""
backup_host_path=""
previous_release=""
previous_image=""
transaction_started=0
backend_switch_started=0
update_completed=0

fail() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "Required command is unavailable: $1"
}

require_file() {
  [[ -f "$1" ]] || fail "Required file is missing: $1"
}

validate_root_owned_directory() {
  local target="$1"
  local owner permissions
  [[ -d "${target}" && ! -L "${target}" ]] || fail "Required directory is missing or unsafe: ${target}"
  owner="$(stat --format='%U:%G' "${target}")"
  permissions="$(stat --format='%a' "${target}")"
  [[ "${owner}" == "root:root" ]] || fail "Directory must be root:root: ${target}"
  (( (8#${permissions} & 0022) == 0 )) || fail "Directory must not be group/world writable: ${target}"
  if find "${target}" -xdev \( ! -user root -o ! -group root -o -perm /022 \) -print -quit | grep -q .; then
    fail "Staging content must be root:root and not group/world writable: ${target}"
  fi
}

archive_payload_bytes() {
  python3 - "$@" <<'PY'
from pathlib import PurePosixPath
import sys
import tarfile

sizes = []
for archive in sys.argv[1:]:
    with tarfile.open(archive, mode="r:gz") as bundle:
        members = bundle.getmembers()
        if not members:
            raise SystemExit(f"archive is empty: {archive}")
        for member in members:
            path = PurePosixPath(member.name)
            if path.is_absolute() or ".." in path.parts:
                raise SystemExit(f"unsafe archive path: {member.name}")
            if not (member.isdir() or member.isfile()):
                raise SystemExit(f"unsupported archive member: {member.name}")
        sizes.append(sum(member.size for member in members if member.isfile()))
print(*sizes)
PY
}

read_config_value() {
  local key="$1"
  local count value
  count="$(grep -cE "^${key}=" "${HOST_CONFIG}" || true)"
  [[ "${count}" == "1" ]] || fail "Host config must define ${key} exactly once"
  value="$(sed -n "s/^${key}=//p" "${HOST_CONFIG}")"
  [[ -n "${value}" && "${value}" != *$'\n'* && "${value}" != *$'\r'* ]] || \
    fail "Host config value is invalid: ${key}"
  printf '%s' "${value}"
}

load_healthcheck_helper() {
  require_file "${HEALTHCHECK_HELPER}"
  [[ ! -L "${HEALTHCHECK_HELPER}" ]] || fail "Health-check helper must not be a symlink"
  [[ "$(stat --format='%U:%G:%a' "${HEALTHCHECK_HELPER}")" == "root:root:755" ]] || \
    fail "Health-check helper must be root:root mode 0755"
  # shellcheck source=/usr/local/lib/vzn-activity-tracker/healthcheck.sh
  source "${HEALTHCHECK_HELPER}"
}

wait_for_local_health() {
  local attempt
  for attempt in {1..30}; do
    if curl --fail --silent --show-error --connect-timeout 2 --max-time 5 \
      http://127.0.0.1:8088/api/v1/health >/dev/null; then
      return 0
    fi
    sleep 2
  done
  docker compose --project-directory "${APP_ROOT}" logs --tail=100 backend || true
  return 1
}

backup_database() {
  backup_container_path="$(docker compose --project-directory "${APP_ROOT}" exec -T backend \
    python -m app.backup create)"
  [[ "${backup_container_path}" =~ ^/data/backups/vzn-[0-9]{8}T[0-9]{6}Z\.sqlite3$ ]] || \
    fail "Backup command returned an unexpected path"
  backup_host_path="${APP_ROOT}/data/backups/$(basename "${backup_container_path}")"
  [[ -f "${backup_host_path}" && ! -L "${backup_host_path}" ]] || \
    fail "SQLite backup was not created in the VZN data directory"
  docker compose --project-directory "${APP_ROOT}" exec -T backend \
    python -m app.backup verify "${backup_container_path}" >/dev/null
  printf 'Verified SQLite backup: %s\n' "${backup_host_path}"
}

restore_database() {
  [[ -n "${backup_container_path}" ]] || return 1
  docker run --rm --user 10001:10001 \
    --volume "${APP_ROOT}/data:/data" \
    "${previous_image}" \
    python -m app.backup restore "${backup_container_path}" --database /data/vzn.sqlite3 >/dev/null
}

restore_pre_switch_state() {
  set +e
  printf 'Update failed before the backend switch; restoring only previous VZN control files and frontend release.\n' >&2
  if ! install -o root -g root -m 0600 "${transaction_root}/.env" "${APP_ROOT}/.env"; then
    printf 'ERROR: Previous VZN environment could not be restored. Manual recovery is required.\n' >&2
    return
  fi
  if ! install -o root -g root -m 0644 "${transaction_root}/compose.yaml" "${APP_ROOT}/compose.yaml"; then
    printf 'ERROR: Previous VZN Compose file could not be restored. Manual recovery is required.\n' >&2
    return
  fi
  if ! ln -s "${previous_release}" "${APP_ROOT}/current.previous" || \
    ! mv -T "${APP_ROOT}/current.previous" "${APP_ROOT}/current"; then
    printf 'ERROR: Previous VZN frontend release could not be restored. Manual recovery is required.\n' >&2
    return
  fi
  if ! rm -f "${UPDATE_MARKER}"; then
    printf 'ERROR: Update marker could not be removed after pre-switch recovery. Manual recovery is required.\n' >&2
  fi
}

restore_previous_state() {
  set +e
  printf 'Update failed; restoring only the previous VZN release and its verified SQLite backup.\n' >&2
  if ! docker compose --project-directory "${APP_ROOT}" stop backend; then
    printf 'ERROR: The VZN backend did not stop; database restore is intentionally skipped. Manual recovery is required.\n' >&2
    return
  fi
  if ! restore_database; then
    printf 'ERROR: SQLite restore failed; the VZN backend remains stopped to avoid data damage. Manual recovery is required.\n' >&2
    return
  fi
  install -o root -g root -m 0600 "${transaction_root}/.env" "${APP_ROOT}/.env"
  install -o root -g root -m 0644 "${transaction_root}/compose.yaml" "${APP_ROOT}/compose.yaml"
  ln -s "${previous_release}" "${APP_ROOT}/current.previous"
  mv -T "${APP_ROOT}/current.previous" "${APP_ROOT}/current"
  if ! docker compose --project-directory "${APP_ROOT}" up --detach --no-build --force-recreate backend; then
    printf 'ERROR: Previous VZN backend could not be restarted; manual recovery is required.\n' >&2
    return
  fi
  if ! wait_for_local_health; then
    printf 'ERROR: Previous VZN backend did not become healthy; manual recovery is required.\n' >&2
    return
  fi
  wait_for_public_https_health "vzn.fawlog.cc" "${public_ipv4}" \
    "${HTTPS_HEALTH_MAX_ATTEMPTS}" "${HTTPS_CONNECT_TIMEOUT_SECONDS}" \
    "${HTTPS_REQUEST_TIMEOUT_SECONDS}" "${HTTPS_RETRY_DELAY_SECONDS}" || \
    printf 'ERROR: Previous VZN backend is local-healthy but public HTTPS recovery did not pass.\n' >&2
}

on_exit() {
  local exit_code="$?"
  trap - EXIT INT TERM
  if (( exit_code != 0 && transaction_started == 1 && update_completed == 0 )); then
    if (( backend_switch_started == 1 )); then
      restore_previous_state
    else
      restore_pre_switch_state
    fi
  fi
  exit "${exit_code}"
}

trap on_exit EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

[[ "${EUID}" -eq 0 ]] || fail "Run this updater as root"
[[ "$#" -eq 0 ]] || fail "This updater accepts no arguments"
for command_name in curl df docker du find grep install nginx python3 sha256sum stat systemctl tar; do
  require_command "${command_name}"
done
load_healthcheck_helper

validate_root_owned_directory "${STAGING_ROOT}"
validate_root_owned_directory "${SOURCE_ROOT}"
validate_root_owned_directory "${FRONTEND_ROOT}"
validate_root_owned_directory "${BACKEND_ROOT}"
require_file "${HOST_CONFIG}"
[[ ! -L "${HOST_CONFIG}" ]] || fail "Host config must not be a symlink"
[[ "$(stat --format='%U:%G:%a' "${HOST_CONFIG}")" == "root:root:600" ]] || \
  fail "Host config must be root:root mode 0600"
public_ipv4="$(read_config_value VZN_PUBLIC_IPV4)"

[[ -d "${APP_ROOT}" && ! -L "${APP_ROOT}" ]] || fail "VZN application root is missing or unsafe"
[[ ! -e "${UPDATE_MARKER}" && ! -L "${UPDATE_MARKER}" ]] || \
  fail "An interrupted VZN update marker exists; inspect its root-only transaction backup before another update"
[[ -f "${APP_ROOT}/.env" && ! -L "${APP_ROOT}/.env" ]] || fail "VZN environment file is missing or unsafe"
[[ "$(stat --format='%U:%G:%a' "${APP_ROOT}/.env")" == "root:root:600" ]] || \
  fail "VZN environment file must be root:root mode 0600"
[[ -f "${APP_ROOT}/compose.yaml" && ! -L "${APP_ROOT}/compose.yaml" ]] || fail "VZN Compose file is missing or unsafe"
[[ "$(stat --format='%U:%G:%a' "${APP_ROOT}/compose.yaml")" == "root:root:644" ]] || \
  fail "VZN Compose file must be root:root mode 0644"
[[ -d "${APP_ROOT}/data" && ! -L "${APP_ROOT}/data" ]] || fail "VZN data directory is missing or unsafe"
[[ "$(stat --format='%u:%g:%a' "${APP_ROOT}/data")" == "10001:10001:750" ]] || \
  fail "VZN data directory has unexpected ownership or mode"
[[ -L "${APP_ROOT}/current" ]] || fail "VZN current release link is missing"
previous_release="$(readlink --canonicalize-existing "${APP_ROOT}/current")"
[[ "${previous_release}" == "${APP_ROOT}/releases/"* && -d "${previous_release}" ]] || \
  fail "VZN current release link points outside the application releases"

[[ "$(systemctl is-active docker)" == "active" ]] || fail "Docker is not active"
[[ "$(systemctl is-active nginx)" == "active" ]] || fail "Nginx is not active"
docker compose version >/dev/null
nginx -t
docker container inspect "${CONTAINER_NAME}" >/dev/null
[[ "$(docker container inspect --format '{{ index .Config.Labels "com.docker.compose.project" }}' "${CONTAINER_NAME}")" == "vzn-activity-tracker" ]] || \
  fail "The VZN container does not belong to the expected Compose project"
wait_for_local_health || fail "Existing VZN backend is not healthy; update is refused"

require_file "${SOURCE_ROOT}/REVISION"
require_file "${SOURCE_ROOT}/compose.yaml"
require_file "${SOURCE_ROOT}/scripts/set_image_tag.py"
mapfile -t frontend_archives < <(find "${FRONTEND_ROOT}" -maxdepth 1 -type f -name 'vzn-frontend-*.tar.gz' -print)
mapfile -t backend_archives < <(find "${BACKEND_ROOT}" -maxdepth 1 -type f -name 'vzn-backend-*.tar.gz' -print)
mapfile -t backend_manifests < <(find "${BACKEND_ROOT}" -maxdepth 1 -type f -name 'vzn-backend-*.manifest' -print)
[[ "${#frontend_archives[@]}" -eq 1 && "${#backend_archives[@]}" -eq 1 && "${#backend_manifests[@]}" -eq 1 ]] || \
  fail "Expected exactly one frontend archive, backend archive, and backend manifest"
frontend_archive="${frontend_archives[0]}"
backend_archive="${backend_archives[0]}"
backend_manifest="${backend_manifests[0]}"
require_file "${frontend_archive}.sha256"
require_file "${backend_archive}.sha256"
(cd "${FRONTEND_ROOT}" && sha256sum --check "$(basename "${frontend_archive}.sha256")")
(cd "${BACKEND_ROOT}" && sha256sum --check "$(basename "${backend_archive}.sha256")")
read -r frontend_payload_bytes backend_payload_bytes < <(archive_payload_bytes "${frontend_archive}" "${backend_archive}")
commit="$(sed -n 's/^GIT_COMMIT=//p' "${backend_manifest}")"
image_tag="$(sed -n 's/^VZN_IMAGE_TAG=//p' "${backend_manifest}")"
source_commit="$(tr -d '\r\n' < "${SOURCE_ROOT}/REVISION")"
[[ "${commit}" =~ ^[0-9a-f]{40}$ && "${source_commit}" == "${commit}" ]] || \
  fail "Deployment source and backend manifest commits differ or are invalid"
[[ "${image_tag}" == "ci-${commit}" ]] || fail "Backend image tag does not match the commit"
[[ "$(basename "${frontend_archive}")" == "vzn-frontend-${commit}.tar.gz" ]] || fail "Frontend artifact does not match the commit"
[[ "$(basename "${backend_archive}")" == "vzn-backend-${commit}.tar.gz" ]] || fail "Backend artifact does not match the commit"

previous_image_tag="$(python3 "${SOURCE_ROOT}/scripts/set_image_tag.py" read "${APP_ROOT}/.env")"
previous_image="vzn-activity-tracker-backend:${previous_image_tag}"
running_image="$(docker container inspect --format '{{.Config.Image}}' "${CONTAINER_NAME}")"
[[ "${running_image}" == "${previous_image}" ]] || \
  fail "Existing backend image does not match the configured VZN image tag"
docker image inspect "${previous_image}" >/dev/null || \
  fail "Configured previous VZN backend image is unavailable for rollback"

available_bytes="$(df --output=avail --block-size=1 / | tail -n 1 | tr -d ' ')"
source_bytes="$(du -sb -- "${SOURCE_ROOT}" | awk '{print $1}')"
data_bytes="$(du -sb -- "${APP_ROOT}/data" | awk '{print $1}')"
[[ "${available_bytes}" =~ ^[0-9]+$ && "${source_bytes}" =~ ^[0-9]+$ && "${data_bytes}" =~ ^[0-9]+$ ]] || \
  fail "Unable to determine disk usage"
estimated_peak_bytes=$((backend_payload_bytes * 3 + frontend_payload_bytes + source_bytes + data_bytes + UPDATE_OVERHEAD_BYTES))
required_available_bytes=$((MINIMUM_RESERVE_BYTES + estimated_peak_bytes))
printf 'Update disk preflight: available=%s bytes, conservative peak=%s bytes, required=%s bytes (includes verified database backup and 512 MiB reserve).\n' \
  "${available_bytes}" "${estimated_peak_bytes}" "${required_available_bytes}"
(( available_bytes >= required_available_bytes )) || \
  fail "Insufficient disk space for the conservative update peak and 512 MiB post-update reserve"

release_id="$(date -u +%Y%m%dT%H%M%SZ)-${commit:0:12}"
release_root="${APP_ROOT}/releases/${release_id}"
[[ ! -e "${release_root}" && ! -L "${release_root}" ]] || fail "Target release already exists"
install -d -o root -g root -m 0750 "${BACKUP_ROOT}"
transaction_root="$(mktemp -d "${BACKUP_ROOT}/update-${release_id}.XXXXXX")"
chmod 0700 "${transaction_root}"
install -o root -g root -m 0600 "${APP_ROOT}/.env" "${transaction_root}/.env"
install -o root -g root -m 0644 "${APP_ROOT}/compose.yaml" "${transaction_root}/compose.yaml"
printf 'COMMIT=%s\nRELEASE_ID=%s\nPREVIOUS_RELEASE=%s\nPREVIOUS_IMAGE=%s\n' \
  "${commit}" "${release_id}" "${previous_release}" "${previous_image}" > "${transaction_root}/transaction"
chmod 0600 "${transaction_root}/transaction"

backup_database
printf 'COMMIT=%s\nRELEASE_ID=%s\nTRANSACTION_ROOT=%s\nBACKUP=%s\n' \
  "${commit}" "${release_id}" "${transaction_root}" "${backup_host_path}" > "${UPDATE_MARKER}"
chown root:root "${UPDATE_MARKER}"
chmod 0600 "${UPDATE_MARKER}"
transaction_started=1
install -d -o root -g root -m 0755 "${release_root}/frontend"
tar --extract --gzip --file "${frontend_archive}" --directory "${release_root}/frontend" \
  --no-same-owner --no-same-permissions
find "${release_root}" -type d -exec chmod 0755 {} +
find "${release_root}" -type f -exec chmod 0644 {} +
chown -R root:root "${release_root}"
docker load --input "${backend_archive}"
docker image inspect "vzn-activity-tracker-backend:${image_tag}" >/dev/null
install -o root -g root -m 0644 "${SOURCE_ROOT}/compose.yaml" "${APP_ROOT}/compose.yaml"
python3 "${SOURCE_ROOT}/scripts/set_image_tag.py" set "${APP_ROOT}/.env" "${image_tag}"
ln -s "${release_root}" "${APP_ROOT}/current.next"
mv -T "${APP_ROOT}/current.next" "${APP_ROOT}/current"
backend_switch_started=1
docker compose --project-directory "${APP_ROOT}" up --detach --no-build --force-recreate backend
wait_for_local_health || fail "Updated VZN backend did not become healthy"
wait_for_public_https_health "vzn.fawlog.cc" "${public_ipv4}" \
  "${HTTPS_HEALTH_MAX_ATTEMPTS}" "${HTTPS_CONNECT_TIMEOUT_SECONDS}" \
  "${HTTPS_REQUEST_TIMEOUT_SECONDS}" "${HTTPS_RETRY_DELAY_SECONDS}" || \
  fail "Updated public HTTPS health check did not become ready"
docker compose --project-directory "${APP_ROOT}" ps
rm -f "${UPDATE_MARKER}"
update_completed=1
printf 'Updated VZN release %s from commit %s. Previous control files and verified backup are in %s.\n' \
  "${release_id}" "${commit}" "${transaction_root}"
