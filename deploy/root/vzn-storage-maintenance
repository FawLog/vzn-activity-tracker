#!/usr/bin/env python3
"""Conservative VZN deployment-storage maintenance.

This root-owned helper intentionally has a fixed set of paths.  It never
discovers arbitrary directories, follows symlinks, or prunes Docker globally.
The normal command is a dry run; ``--apply`` is required for deletion.
"""
from __future__ import annotations

import argparse
import fcntl
import json
import os
from pathlib import Path
import re
import shutil
import stat
import subprocess
import sys
import tempfile
import time
from dataclasses import dataclass
from datetime import datetime, timezone

APP = Path("/srv/vzn-activity-tracker")
BACKUPS = Path("/var/backups/vzn-activity-tracker")
AUTO_STATE = Path("/var/lib/vzn-autodeploy")
STATE = Path("/var/lib/vzn-storage-maintenance")
REGISTRY = STATE / "recovery-points.json"
LOCK = AUTO_STATE / "lock"
RELEASES = APP / "releases"
DATA_BACKUPS = APP / "data" / "backups"
RETAIN_PREVIOUS = 3
STALE_SECONDS = 24 * 60 * 60
SHA = re.compile(r"[0-9a-f]{40}")
RELEASE_ID = re.compile(r"[0-9]{8}T[0-9]{6}Z-[0-9a-f]{12}")
IMAGE = re.compile(r"vzn-activity-tracker-backend:ci-([0-9a-f]{40})")


class SafetyError(RuntimeError):
    """A conservative validation failure; no destructive action may proceed."""


def require(condition: bool, message: str) -> None:
    if not condition:
        raise SafetyError(message)


def root_regular(path: Path, mode: int | None = None) -> None:
    entry = path.lstat()
    require(stat.S_ISREG(entry.st_mode) and entry.st_uid == 0 and entry.st_gid == 0,
            f"unsafe root file: {path}")
    require(not stat.S_ISLNK(entry.st_mode) and not entry.st_mode & 0o022,
            f"unsafe root file permissions: {path}")
    if mode is not None:
        require(stat.S_IMODE(entry.st_mode) == mode, f"unexpected mode: {path}")


def root_directory(path: Path, mode: int | None = None) -> None:
    entry = path.lstat()
    require(stat.S_ISDIR(entry.st_mode) and entry.st_uid == 0 and entry.st_gid == 0,
            f"unsafe root directory: {path}")
    require(not stat.S_ISLNK(entry.st_mode) and not entry.st_mode & 0o022,
            f"unsafe root directory permissions: {path}")
    if mode is not None:
        require(stat.S_IMODE(entry.st_mode) == mode, f"unexpected mode: {path}")


def data_directory(path: Path) -> None:
    entry = path.lstat()
    require(stat.S_ISDIR(entry.st_mode) and entry.st_uid == 10001 and entry.st_gid == 10001,
            f"unsafe application data directory: {path}")
    require(not stat.S_ISLNK(entry.st_mode) and not entry.st_mode & 0o022,
            f"unsafe application data directory permissions: {path}")


def data_regular(path: Path) -> None:
    entry = path.lstat()
    require(stat.S_ISREG(entry.st_mode) and entry.st_uid == 10001 and entry.st_gid == 10001,
            f"unsafe application data file: {path}")
    require(not stat.S_ISLNK(entry.st_mode) and not entry.st_mode & 0o022,
            f"unsafe application data file permissions: {path}")


def direct_child(path: Path, parent: Path) -> bool:
    """Reject symlinks and anything outside exactly one expected parent."""
    try:
        return (path.parent == parent and not path.is_symlink()
                and path.resolve(strict=True).parent == parent.resolve(strict=True))
    except OSError:
        return False


def sync_directory(path: Path) -> None:
    descriptor = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def atomic_json(path: Path, value: object) -> None:
    root_directory(path.parent, 0o700)
    descriptor, temporary = tempfile.mkstemp(prefix=".recovery-", dir=path.parent)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            json.dump(value, stream, sort_keys=True, separators=(",", ":"))
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
        root_regular(path, 0o600)
        sync_directory(path.parent)
    finally:
        Path(temporary).unlink(missing_ok=True)


def read_registry() -> dict[str, object]:
    if path_present(STATE):
        root_directory(STATE, 0o700)
    if not path_present(REGISTRY):
        return {"version": 1, "points": []}
    root_regular(REGISTRY, 0o600)
    raw = json.loads(REGISTRY.read_text(encoding="utf-8"))
    require(isinstance(raw, dict) and raw.get("version") == 1 and isinstance(raw.get("points"), list),
            "invalid recovery registry")
    return raw


def valid_point(point: object) -> bool:
    if not isinstance(point, dict):
        return False
    required = {"commit", "release", "image", "transaction", "backup", "recorded_at", "status", "ci_run_id", "compose_sha256"}
    if set(point) != required or point["status"] != "successful":
        return False
    return (
        isinstance(point["commit"], str) and SHA.fullmatch(point["commit"]) is not None
        and isinstance(point["release"], str) and RELEASE_ID.fullmatch(Path(point["release"]).name) is not None
        and isinstance(point["image"], str) and IMAGE.fullmatch(point["image"]) is not None
        and isinstance(point["transaction"], str) and isinstance(point["backup"], str)
        and isinstance(point["recorded_at"], str) and isinstance(point["compose_sha256"], str)
        and re.fullmatch(r"[0-9a-f]{64}", point["compose_sha256"]) is not None
        and (point["ci_run_id"] is None or isinstance(point["ci_run_id"], int))
    )


def record_success(arguments: argparse.Namespace) -> None:
    require(os.geteuid() == 0, "root is required")
    for directory, mode in ((APP, None), (RELEASES, None), (BACKUPS, None)):
        root_directory(directory, mode)
    data_directory(DATA_BACKUPS)
    require(SHA.fullmatch(arguments.commit) is not None, "invalid commit")
    release = Path(arguments.release)
    transaction = Path(arguments.transaction)
    backup = Path(arguments.backup)
    image = arguments.image
    require(direct_child(release, RELEASES) and RELEASE_ID.fullmatch(release.name) is not None,
            "unsafe release path")
    require(direct_child(transaction, BACKUPS) and transaction.name.startswith("update-"),
            "unsafe transaction path")
    require(direct_child(backup, DATA_BACKUPS) and re.fullmatch(r"vzn-[0-9]{8}T[0-9]{6}Z\.sqlite3", backup.name),
            "unsafe backup path")
    root_directory(release)
    root_directory(transaction, 0o700)
    data_regular(backup)
    require(IMAGE.fullmatch(image) is not None and image.endswith(arguments.commit), "invalid image tag")
    compose = APP / "compose.yaml"
    root_regular(compose, 0o644)
    current = APP / "current"
    require(current.is_symlink() and current.resolve(strict=True) == release.resolve(strict=True),
            "current release does not match successful deployment")
    if STATE.exists():
        root_directory(STATE, 0o700)
    else:
        STATE.mkdir(mode=0o700, parents=True)
    root_directory(STATE, 0o700)
    registry = read_registry()
    points = registry["points"]
    assert isinstance(points, list)
    point = {
        "commit": arguments.commit,
        "release": str(release),
        "image": image,
        "transaction": str(transaction),
        "backup": str(backup),
        "recorded_at": datetime.now(timezone.utc).isoformat(),
        "status": "successful",
        "ci_run_id": arguments.ci_run_id,
        "compose_sha256": __import__("hashlib").sha256(compose.read_bytes()).hexdigest(),
    }
    points[:] = [item for item in points if not (isinstance(item, dict) and item.get("commit") == arguments.commit)]
    points.append(point)
    atomic_json(REGISTRY, registry)
    print(f"Recorded VZN recovery point {arguments.commit}")


@dataclass(frozen=True)
class Candidate:
    kind: str
    path: str
    reason: str


def operation_active() -> bool:
    return any(path.exists() or path.is_symlink() for path in (APP / ".vzn-updating", APP / ".vzn-installing"))


def pending_images(registry: dict[str, object]) -> list[str]:
    """Retired releases may still have Docker tags protected by other references."""
    images = registry.get("pending_images", [])
    require(isinstance(images, list) and all(isinstance(tag, str) and IMAGE.fullmatch(tag)
                                             for tag in images),
            "invalid pending recovery images")
    require(len(set(images)) == len(images), "duplicate pending recovery images")
    return images


def registry_points(registry: dict[str, object]) -> list[dict[str, object]]:
    points = registry["points"]
    require(isinstance(points, list) and all(valid_point(point) for point in points),
            "invalid recovery point registry")
    require(len({point["commit"] for point in points}) == len(points)
            and len({point["release"] for point in points}) == len(points),
            "duplicate recovery point commit or release")
    pending_images(registry)
    return points


def select_protected(points: list[dict[str, object]]) -> list[dict[str, object]]:
    current = APP / "current"
    require(current.is_symlink(), "current release is missing")
    current_release = str(current.resolve(strict=True))
    matching = [point for point in points if point["release"] == current_release]
    require(len(matching) == 1, "current release lacks exactly one recovery point")
    ordered = sorted(points, key=lambda point: str(point["recorded_at"]), reverse=True)
    retained = ordered[: RETAIN_PREVIOUS + 1]
    # A manual rollback or timestamp anomaly must never make current deletable.
    if matching[0] not in retained:
        retained.append(matching[0])
    return retained


def validate_point_paths(point: dict[str, object], *, release_missing: bool = False) -> None:
    release = Path(str(point["release"]))
    transaction = Path(str(point["transaction"]))
    backup = Path(str(point["backup"]))
    commit = point["commit"]
    release_ok = (release.parent == RELEASES and RELEASE_ID.fullmatch(release.name) is not None
                  and not release.is_symlink())
    if release_missing:
        release_ok = release_ok and not path_present(release)
    else:
        release_ok = release_ok and direct_child(release, RELEASES) and release.is_dir()
    require(release_ok, f"invalid recovery point release path: {commit} {release}")
    require(direct_child(transaction, BACKUPS) and transaction.name.startswith("update-")
            and transaction.is_dir(),
            f"invalid recovery point transaction path: {commit} {transaction}")
    require(direct_child(backup, DATA_BACKUPS) and re.fullmatch(r"vzn-[0-9]{8}T[0-9]{6}Z\\.sqlite3", backup.name)
            and backup.is_file(),
            f"invalid recovery point backup path: {commit} {backup}")


def protected_points(registry: dict[str, object]) -> list[dict[str, object]]:
    points = registry_points(registry)
    for point in points:
        validate_point_paths(point)
    return select_protected(points)


def old_enough(path: Path) -> bool:
    return time.time() - path.lstat().st_mtime >= STALE_SECONDS


def staging_build_only(path: Path) -> bool:
    """Only recognize the exact root-owned structure produced by the stager."""
    if not direct_child(path, BACKUPS) or not path.name.startswith("staged-update-"):
        return False
    try:
        root_directory(path, 0o750)
    except (OSError, SafetyError):
        return False
    allowed = {"source", "frontend", "backend", "deployment"}
    entries = list(path.iterdir())
    if {entry.name for entry in entries} != allowed or any(entry.is_symlink() for entry in entries):
        return False
    try:
        return all(entry.is_dir() and entry.resolve(strict=True).parent == path.resolve(strict=True) for entry in entries)
    except OSError:
        return False


def stale_temporary(path: Path) -> bool:
    if not direct_child(path, AUTO_STATE) or not path.name.startswith("download-"):
        return False
    try:
        root_directory(path)
    except (OSError, SafetyError):
        return False
    return old_enough(path)


def candidates(registry: dict[str, object]) -> list[Candidate]:
    require(not operation_active(), "deployment marker exists; cleanup is refused")
    retained = protected_points(registry)
    retained_releases = {str(point["release"]) for point in retained}
    retained_images = {str(point["image"]) for point in retained}
    result: list[Candidate] = []
    points = registry["points"]
    assert isinstance(points, list)
    # A legacy release without an explicit recovery point is intentionally not a candidate.
    for point in points:
        release = Path(str(point["release"]))
        if str(release) not in retained_releases and direct_child(release, RELEASES) and release.is_dir():
            result.append(Candidate("release", str(release), "recovery point exceeds current plus three previous"))
    for directory in BACKUPS.glob("staged-update-*"):
        if staging_build_only(directory) and old_enough(directory):
            result.append(Candidate("staging", str(directory), "verified build-only staging snapshot older than 24 hours"))
    if AUTO_STATE.is_dir():
        for directory in AUTO_STATE.glob("download-*"):
            if stale_temporary(directory):
                result.append(Candidate("temporary", str(directory), "root worker download residue older than 24 hours"))
    # A successfully retired release moves its tag into a durable pending queue.
    # Shared or protected tags must not be deleted while any retained point uses them.
    retiring = {item.path for item in result if item.kind == "release"}
    images = pending_images(registry) + [str(point["image"]) for point in points
                                         if point["release"] in retiring]
    for image in dict.fromkeys(images):
        if image not in retained_images:
            result.append(Candidate("image", image, "unretained recovery image; requires Docker reference checks"))
    return result


def docker_safe_to_remove(tag: str) -> bool:
    require(IMAGE.fullmatch(tag) is not None, "unsafe Docker tag")
    inspected = subprocess.run(["/usr/bin/docker", "image", "inspect", tag, "--format", "{{.Id}} {{json .RepoTags}}"],
                               check=False, text=True, capture_output=True)
    if inspected.returncode != 0:
        return False
    image_id, _, raw_tags = inspected.stdout.strip().partition(" ")
    try:
        tags = json.loads(raw_tags)
    except json.JSONDecodeError:
        return False
    if not isinstance(tags, list) or tags != [tag]:
        return False
    containers = subprocess.run(["/usr/bin/docker", "container", "ls", "--all", "--quiet"],
                                check=True, text=True, capture_output=True).stdout.split()
    if not containers:
        return True
    references = subprocess.run(["/usr/bin/docker", "container", "inspect", "--format", "{{.Image}} {{.Config.Image}}", *containers],
                                check=True, text=True, capture_output=True).stdout.splitlines()
    return all(image_id not in line.split() and tag not in line.split() for line in references)


def docker_tag_present(tag: str) -> bool:
    require(IMAGE.fullmatch(tag) is not None, "unsafe Docker tag")
    # A successful listing distinguishes an absent tag from an unavailable daemon.
    output = subprocess.run(["/usr/bin/docker", "image", "ls", "--all", "--format", "{{.Repository}}:{{.Tag}}"],
                            check=True, text=True, capture_output=True).stdout.splitlines()
    return tag in output


def remove_tree(path: Path) -> int:
    require(not path.is_symlink() and path.is_dir(), f"unsafe deletion target: {path}")
    root_device = path.lstat().st_dev
    pending = [path]
    while pending:
        directory = pending.pop()
        with os.scandir(directory) as entries:
            for entry in entries:
                metadata = entry.stat(follow_symlinks=False)
                require(not stat.S_ISLNK(metadata.st_mode), f"symlink inside deletion target: {entry.path}")
                require(metadata.st_dev == root_device, f"nested mount inside deletion target: {entry.path}")
                require(stat.S_ISREG(metadata.st_mode) or stat.S_ISDIR(metadata.st_mode),
                        f"unsupported entry inside deletion target: {entry.path}")
                if stat.S_ISDIR(metadata.st_mode):
                    pending.append(Path(entry.path))
    before = shutil.disk_usage(path.parent).free
    shutil.rmtree(path)
    return max(0, shutil.disk_usage(path.parent).free - before)


def intent_path() -> Path:
    return STATE / "cleanup-intent.json"


def path_present(path: Path) -> bool:
    # Only ENOENT is evidence of absence; other filesystem failures are unsafe.
    try:
        path.lstat()
    except FileNotFoundError:
        return False
    return True


def begin_release_cleanup(registry: dict[str, object], point: dict[str, object]) -> None:
    require(point in registry_points(registry) and point not in protected_points(registry),
            "refusing to retire a protected recovery point")
    release = Path(str(point["release"]))
    root_directory(release)
    metadata = release.lstat()
    require(not path_present(intent_path()), "another cleanup intent exists")
    # Persist the exact point and directory identity before any destructive operation.
    atomic_json(intent_path(), {"version": 1, "point": point,
                                "device": metadata.st_dev, "inode": metadata.st_ino})


def clear_intent() -> None:
    root_regular(intent_path(), 0o600)
    intent_path().unlink()
    sync_directory(STATE)


def retire_point(registry: dict[str, object], point: dict[str, object]) -> dict[str, object]:
    return {**registry, "points": [item for item in registry_points(registry) if item != point],
            "pending_images": list(dict.fromkeys([*pending_images(registry), str(point["image"])]))}


def resume_release_cleanup(registry: dict[str, object], apply: bool) -> tuple[dict[str, object], int]:
    """Only an exact, durable cleanup intent can explain a missing registered release.

    With no intent, ordinary missing paths still fail closed. A dry run may
    simulate retirement but never changes the intent, registry, or resources.
    """
    if not path_present(intent_path()):
        return registry, 0
    root_directory(STATE, 0o700)
    root_regular(intent_path(), 0o600)
    intent = json.loads(intent_path().read_text(encoding="utf-8"))
    require(isinstance(intent, dict) and set(intent) == {"version", "point", "device", "inode"}
            and intent["version"] == 1 and valid_point(intent["point"])
            and type(intent["device"]) is int and intent["device"] >= 0
            and type(intent["inode"]) is int and intent["inode"] > 0,
            "invalid release cleanup intent")
    point = intent["point"]
    release = Path(str(point["release"]))
    present = path_present(release)
    validate_point_paths(point, release_missing=not present)
    points = registry_points(registry)
    matches = [item for item in points if item["commit"] == point["commit"] or item["release"] == point["release"]]
    if not matches:
        # Crash after registry replacement but before unlinking the intent.
        require(not present and point["image"] in pending_images(registry),
                "cleanup intent does not match completed retirement")
        protected_points(registry)
        if apply:
            clear_intent()
        return registry, 0
    require(matches == [point], "cleanup intent does not match registered recovery point")
    require(point not in select_protected(points), "cleanup intent references a protected recovery point")
    for item in points:
        if item != point:
            validate_point_paths(item)
    freed = 0
    if present:
        root_directory(release)
        metadata = release.lstat()
        require((metadata.st_dev, metadata.st_ino) == (intent["device"], intent["inode"]),
                "cleanup intent directory identity changed")
        if not apply:
            return registry, 0
        # A failed or partial deletion leaves the point and intent intact.
        freed = remove_tree(release)
        require(not path_present(release), "release still exists after cleanup")
    updated = retire_point(registry, point)
    protected_points(updated)
    if apply:
        # Order matters: durable removal, durable registry, then durable intent removal.
        sync_directory(RELEASES)
        atomic_json(REGISTRY, updated)
        clear_intent()
    else:
        print(f"CANDIDATE reconcile completed release deletion {point['commit']}: {release}")
    return updated, freed


def forget_pending_image(registry: dict[str, object], tag: str) -> dict[str, object]:
    updated = {**registry, "pending_images": [image for image in pending_images(registry) if image != tag]}
    atomic_json(REGISTRY, updated)
    return updated


def inherited_lock() -> int | None:
    """Use the worker/updater lock when it was deliberately passed to us."""
    raw = os.environ.get("VZN_OPERATION_LOCK_FD")
    if raw is None:
        return None
    require(raw.isdecimal(), "invalid inherited operation lock")
    descriptor = int(raw)
    try:
        actual = os.fstat(descriptor)
        expected = LOCK.stat()
    except OSError as error:
        raise SafetyError("invalid inherited operation lock") from error
    require(stat.S_ISREG(actual.st_mode)
            and (actual.st_dev, actual.st_ino) == (expected.st_dev, expected.st_ino),
            "inherited operation lock does not match")
    return descriptor


def run_cleanup(apply: bool) -> int:
    require(os.geteuid() == 0, "root is required")
    if AUTO_STATE.exists():
        root_directory(AUTO_STATE, 0o700)
    else:
        AUTO_STATE.mkdir(mode=0o700, parents=True)
    root_directory(AUTO_STATE, 0o700)
    inherited = inherited_lock()
    with LOCK.open("a+") if inherited is None else os.fdopen(os.dup(inherited), "a+") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print("VZN maintenance deferred: deployment lock is held")
            return 0
        require(not operation_active(), "deployment marker exists; cleanup is refused")
        for directory in (APP, RELEASES, BACKUPS):
            root_directory(directory)
        registry, freed = resume_release_cleanup(read_registry(), apply)
        planned = candidates(registry)
        for item in planned:
            if item.kind == "image":
                if apply:
                    require(item.path in pending_images(registry), "image has no retired recovery point")
                    if any(point["image"] == item.path for point in registry_points(registry)):
                        print(f"KEEP image {item.path}: registered recovery point protection")
                        continue
                if not docker_safe_to_remove(item.path):
                    if apply and not docker_tag_present(item.path):
                        # Includes a crash after a successful Docker removal, before registry write.
                        registry = forget_pending_image(registry, item.path)
                        print(f"ABSENT image {item.path}: retired tag already removed")
                    else:
                        print(f"KEEP image {item.path}: container or additional tag protection")
                    continue
                if apply:
                    subprocess.run(["/usr/bin/docker", "image", "rm", item.path], check=True)
                    require(not docker_tag_present(item.path), "retired image tag still exists after cleanup")
                    registry = forget_pending_image(registry, item.path)
                print(f"{'REMOVE' if apply else 'CANDIDATE'} image {item.path}: {item.reason}")
                continue
            path = Path(item.path)
            if apply:
                if item.kind == "release":
                    matches = [point for point in registry_points(registry) if point["release"] == item.path]
                    require(len(matches) == 1, "release has no unique recovery point")
                    begin_release_cleanup(registry, matches[0])
                    registry, released = resume_release_cleanup(registry, True)
                    freed += released
                else:
                    freed += remove_tree(path)
            print(f"{'REMOVE' if apply else 'CANDIDATE'} {item.kind} {path}: {item.reason}")
        print(f"VZN maintenance {'applied' if apply else 'dry-run'}; measured_free_bytes={freed}")
    return 0


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(description=__doc__)
    commands = result.add_subparsers(dest="command", required=True)
    cleanup = commands.add_parser("cleanup", help="list candidates, or remove them with --apply")
    cleanup.add_argument("--apply", action="store_true")
    record = commands.add_parser("record-success", help="record a health-verified successful update")
    record.add_argument("--commit", required=True)
    record.add_argument("--release", required=True)
    record.add_argument("--image", required=True)
    record.add_argument("--transaction", required=True)
    record.add_argument("--backup", required=True)
    record.add_argument("--ci-run-id", type=int)
    return result


def main() -> int:
    arguments = parser().parse_args()
    if arguments.command == "record-success":
        record_success(arguments)
        return 0
    return run_cleanup(arguments.apply)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (SafetyError, OSError, subprocess.CalledProcessError, json.JSONDecodeError) as error:
        print(f"ERROR: {error}", file=sys.stderr)
        raise SystemExit(1)
